  textComponent: {fileID: 975240397}
  speakerName: {fileID: 1509483240}
  textStart: 0
  unitName: Jasper
  lines:
  - What is your problem?
  - Relax. Did they not have dirt in the city or something?
  - Yael, this is something called <i>grass</i>. I know it's scary.
  - I'm sorry your butler couldn't come with you, Yael.
  - I can tell better jokes in my sleep.
  - I'm so far from home.
  - Can't wait to get some sleep.
  textSpeed: 0.001
  waitTime: 0
  _animation: {fileID: 798878599}
  _notification: {fileID: 798878600}
