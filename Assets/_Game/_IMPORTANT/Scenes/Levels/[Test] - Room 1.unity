    - target: {fileID: 7848476467226314218, guid: 605a4d433c9b7a148b997bab62d81817,
        type: 3}
      propertyPath: lines.Array.data[4]
      value: No use dragging our feet, Jasper.
      objectReference: {fileID: 0}
