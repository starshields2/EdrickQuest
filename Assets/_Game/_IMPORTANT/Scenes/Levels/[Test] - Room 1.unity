    - target: {fileID: 7848476467226314218, guid: 605a4d433c9b7a148b997bab62d81817,
        type: 3}
      propertyPath: lines.Array.data[1]
      value: Look at this miserable storm. We have to do something.
      objectReference: {fileID: 0}
    - target: {fileID: 7848476467226314218, guid: 605a4d433c9b7a148b997bab62d81817,
        type: 3}
      propertyPath: lines.Array.data[2]
      value: It <b>spreads</b>.
      objectReference: {fileID: 0}
    - target: {fileID: 7848476467226314218, guid: 605a4d433c9b7a148b997bab62d81817,
        type: 3}
      propertyPath: lines.Array.data[3]
      value: We have to hurry.
      objectReference: {fileID: 0}
    - target: {fileID: 7848476467226314218, guid: 605a4d433c9b7a148b997bab62d81817,
        type: 3}
      propertyPath: lines.Array.data[4]
      value: No use dragging our feet, Jasper.
      objectReference: {fileID: 0}
    - target: {fileID: 7848476467226314218, guid: 605a4d433c9b7a148b997bab62d81817,
        type: 3}
      propertyPath: lines.Array.data[5]
      value: I pray for our success.
