  m_Script: {fileID: 11500000, guid: a5d41b0ae9146f24b98e7835798889fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  campDialogue: {fileID: 0}
  Skills:
  - {fileID: 8135059753621438595}
  - {fileID: 66270483731250452}
  - {fileID: 8513769138747953331}
  - {fileID: 4863748233284436172}
  - {fileID: 2306006065677737229}
  - {fileID: 4649829643717648451}
  SkillInfo:
  - Berate an enemy and reduce their damage input.
  - 'Heal Jasper for 1-6 HP. '
  - Protect Jasper from harm for two turns.
  - Increase Jasper's damage by 50% until her next attack.
  - Summon a lunar construct that takes damage for Jasper.
  - If Jasper dies, recover her to 10HP.
  EdQuote:
  - She seems to have a handle on this.
  - 'Convince Yael she needs Jasper alive. '
  - Yael needs to see Jasper isn't as tough as she lets on.
  - 'The journey must take priority. We need to be fast! '
  - Jasper actually enjoys things that take finesse. Maybe they have things in common.
  - 'Yael cannot give up on this journey! '
  YaQuote:
  - Well I can do that any time, gladly!
  - A Moonwalker's healing magic is not for outsiders.
  - Why waste expertise on someone who has a shield?
  - I thought that sword was plenty big. Now she needs me?
  - Such a spell isn't fit for her lack of finesse.
  - 'If she dies, she dies. '
  skillAvailable: 0
  skillBox: {fileID: 5722449389258154924}
  YQuote: {fileID: 88120582027908382}
  EQuote: {fileID: 5040219732579807193}
  skillDescription: {fileID: 2552374715175874101}
  BerateOn: 0
  HealOn: 0
  skill1: {fileID: 0}
  skill2: {fileID: 0}
